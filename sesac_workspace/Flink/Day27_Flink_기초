            "(in,1)\n",
            "(is,1)\n",
            "(of,2)\n",
            "(or,1)\n",
            "(to,3)\n",
            "(The,1)\n",
            "(and,1)\n",
            "(be,,1)\n",
            "(not,1)\n",
            "(sea,1)\n",
            "(the,2)\n",
            "('tis,1)\n",
            "(arms,1)\n",
            "(mind,1)\n",
            "(take,1)\n",
            "(arrows,1)\n",
            "(nobler,1)\n",
            "(slings,1)\n",
            "(suffer,1)\n",
            "(Whether,1)\n",
            "(against,1)\n",
            "(fortune,1)\n",
            "(be,--that,1)\n",
            "(troubles,,1)\n",
            "(outrageous,1)\n",
            "(question:--,1)\n"
