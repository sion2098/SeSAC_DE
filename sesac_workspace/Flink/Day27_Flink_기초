      "source": [
        "from pyflink.datastream import KeyedProcessFunction\n",
        "from pyflink.datastream.state import ValueStateDescriptor\n",
        "from pyflink.common.typeinfo import Types\n",
        "from pyflink.datastream.functions import RuntimeContext\n"
      ]
    },
    {
