        "    return s >= 20000\n",
        "\n",
        "filtered = list(filter(is_high, sales))\n",
        "# filtered\n",
        "\n",
        "# 2. map: 10% 세금 적용\n",
        "def tax(s):\n",
        "    return s * 1.1\n",
        "\n",
        "taxed = list(map(tax, filtered))\n",
        "# taxed\n",
        "\n",
        "# 3. reduce: 총합 계산\n",
        "# acc : 누적값, cur : 현재값\n",
        "result = reduce(lambda acc, cur:acc + cur, taxed)\n",
        "result"
      ]
